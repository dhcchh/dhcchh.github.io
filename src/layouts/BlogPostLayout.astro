---
import type { MarkdownHeading } from "astro";
import SiteLayout from "./SiteLayout.astro";
import PostHeader from "../components/blog/PostHeader.astro";
import TableOfContents from "../components/blog/TableOfContents.astro";
import ArticleContent from "../components/blog/ArticleContent.astro";
import PostNavigation from "../components/blog/PostNavigation.astro";
import { siteConfig } from "../config";
import { getOutline, type Post } from "../lib/posts";
interface Props {
  post: Post;
  minutes: number;
  headings: MarkdownHeading[];
  newer?: Post;
  older?: Post;
}
const { post, minutes, headings, newer, older } = Astro.props;
const outline = getOutline(headings);
const showSidebar =
  Astro.slots.has("aside") || (post.data.toc && outline.length > 1);
---

<SiteLayout
  title={`${post.data.title} — ${siteConfig.name}`}
  description={post.data.description}
  image={post.data.cover}
  type="article"
>
  <article class="container blog-post">
    <slot name="header">
      <PostHeader post={post} minutes={minutes} />
    </slot>
    <div class:list={["reading-layout", { "with-sidebar": showSidebar }]}>
      {showSidebar && (
        <aside>
          <slot name="aside">
            <TableOfContents headings={outline} />
          </slot>
        </aside>
      )}
      <div class="article-column">
        <ArticleContent>
          <slot />
        </ArticleContent>
        <slot name="after-content" />
        <PostNavigation newer={newer} older={older} />
      </div>
    </div>
  </article>
</SiteLayout>
<style>
  .blog-post {
    padding-bottom: 5rem;
  }
  .reading-layout {
    padding-top: 3rem;
  }
  .with-sidebar {
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr);
    gap: 4rem;
  }
  .article-column {
    width: 100%;
    max-width: 740px;
    min-width: 0;
    margin-inline: auto;
  }
  @media (max-width: 900px) {
    .with-sidebar {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .reading-layout {
      padding-top: 2rem;
    }
  }
</style>
