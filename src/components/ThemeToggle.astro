---
import { siteConfig } from "../config";
---

{siteConfig.theme.enableDarkMode && (
  <button
    id="theme-toggle"
    type="button"
    aria-label="Toggle color theme"
    title="Toggle color theme"
  >
    <svg
      class="sun"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      aria-hidden="true"
    >
      <circle cx="12" cy="12" r="4" />
      <path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5" />
    </svg>
    <svg
      class="moon"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      aria-hidden="true"
    >
      <path d="M20.5 13A8.5 8.5 0 0 1 11 3.5 8.5 8.5 0 1 0 20.5 13Z" />
    </svg>
  </button>
)}

<script>
  const button = document.getElementById("theme-toggle");
  if (button) {
    const root = document.documentElement;
    const system = window.matchMedia("(prefers-color-scheme: dark)");
    button.addEventListener("click", () => {
      const theme = root.dataset.theme === "dark" ? "light" : "dark";
      root.dataset.theme = root.dataset.themePreference = theme;
      try {
        localStorage.setItem("theme", theme);
      } catch {}
    });
    system.addEventListener("change", ({ matches }) => {
      if (root.dataset.themePreference === "system")
        root.dataset.theme = matches ? "dark" : "light";
    });
  }
</script>

<style>
  button {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid rgb(var(--color-border));
    border-radius: 50%;
  }
  button:hover {
    background: rgb(var(--color-surface));
  }
  svg {
    width: 20px;
    height: 20px;
  }
  .moon,
  :global([data-theme="dark"]) .sun {
    display: none;
  }
  :global([data-theme="dark"]) .moon {
    display: block;
  }
</style>
