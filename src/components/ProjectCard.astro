---
import type { siteConfig } from "../config";
import TagList from "./ui/TagList.astro";
interface Props {
  project: (typeof siteConfig.projects)[number];
  index: number;
  heading?: "h2" | "h3";
}
const { project, index, heading: Heading = "h3" } = Astro.props;
const paragraphs = project.description
  .split(/\n\s*\n/)
  .map((text) => text.trim());
---

<article class="project-card">
  <div class="card-top">
    <span class="eyebrow">{String(index + 1).padStart(2, "0")} / Project</span>
    <span class="date">{project.dateRange}</span>
  </div>
  <Heading class="project-title">{project.name}</Heading>
  <div class="description">
    {paragraphs.map((paragraph) => (
      <p>{paragraph}</p>
    ))}
  </div>
  <div class="skills">
    <TagList items={project.skills} />
  </div>
  <div class="project-links">
    {project.github && (
      <a class="text-link" href={project.github}>
        View code <span aria-hidden="true">↗</span>
        <span class="sr-only"> for {project.name}</span>
      </a>
    )}
    {project.articles.map((article) => (
      <a class="text-link" href={article.link}>
        {article.title}
        <span aria-hidden="true">↗</span>
      </a>
    ))}
  </div>
</article>
<style>
  .project-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    min-width: 0;
    padding: 2rem;
    border: 1px solid rgb(var(--color-border));
    border-radius: 5px;
    background: rgb(var(--color-surface) / 0.45);
  }
  .card-top {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem;
    width: 100%;
  }
  .date {
    font: 0.6rem/1.7 var(--font-mono);
    color: rgb(var(--color-text-muted));
  }
  .project-title {
    font-size: 1.4rem;
    font-weight: 600;
    line-height: 1.35;
    letter-spacing: -0.03em;
    margin-top: 1.7rem;
  }
  .description {
    font-size: 0.9rem;
    line-height: 1.8;
    color: rgb(var(--color-text-secondary));
    margin-top: 1rem;
  }
  .description p + p {
    margin-top: 0.9rem;
  }
  .skills {
    margin-block: 1.5rem;
  }
  .project-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    margin-top: auto;
    padding-top: 1rem;
    width: 100%;
    border-top: 1px solid rgb(var(--color-border));
    font-size: 0.75rem;
  }
  .project-links a {
    align-items: baseline;
  }
  @media (max-width: 700px) {
    .project-card {
      padding: 1.5rem;
    }
  }
</style>
