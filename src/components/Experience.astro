---
import { siteConfig } from "../config";
import Section from "./ui/Section.astro";
import ExperienceItem from "./ExperienceItem.astro";
interface Props {
  heading?: "h1" | "h2";
}
const { heading = "h2" } = Astro.props;
const fullTimeRoles = siteConfig.experience.filter(
  (experience) => !/intern/i.test(experience.title),
);
const internships = siteConfig.experience.filter((experience) =>
  /intern/i.test(experience.title),
);
---

{siteConfig.experience.length > 0 && (
  <Section
    id="experience"
    title="Where I've been."
    heading={heading}
  >
    <p slot="intro" class="experience-intro">
      This is not a standard resume. It is a more personal look at what I learned, not a list of action verbs and numbers. A downloadable resume is coming soon.
    </p>
    {fullTimeRoles.length > 0 && (
      <section class="experience-group" aria-labelledby="full-time-title">
        <p id="full-time-title" class="group-label">Full-time roles</p>
        {fullTimeRoles.map((experience, index) => (
          <ExperienceItem
            experience={experience}
            expanded={index === 0}
            heading={heading === "h1" ? "h2" : "h3"}
          />
        ))}
      </section>
    )}
    {internships.length > 0 && (
      <details class="experience-group internships">
        <summary>
          <span class="group-label">Internships</span>
          <span class="internship-toggle" aria-hidden="true"></span>
        </summary>
        <div class="internship-list">
          {internships.map((experience, index) => (
            <ExperienceItem
              experience={experience}
              expanded={fullTimeRoles.length === 0 && index === 0}
              heading={heading === "h1" ? "h2" : "h3"}
            />
          ))}
        </div>
      </details>
    )}
  </Section>
)}

<style>
  :global(#experience-title) {
    white-space: nowrap;
    font-size: clamp(2rem, 3vw, 2.7rem);
  }

  .experience-intro {
    margin: 1rem 0 0;
    color: rgb(var(--color-text-muted));
    font-size: 0.95rem;
    line-height: 1.65;
  }
  .experience-group + .experience-group {
    margin-top: 2.5rem;
  }
  .group-label {
    margin-bottom: 1.25rem;
    font: 0.7rem/1.7 var(--font-mono);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--link-color);
  }
  .internships summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    list-style: none;
    padding-block: 0.5rem;
    cursor: pointer;
  }
  .internships summary::-webkit-details-marker {
    display: none;
  }
  .internships .group-label {
    margin: 0;
  }
  .internship-toggle {
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border: 1px solid rgb(var(--color-border));
    border-radius: 50%;
  }
  .internship-toggle::before {
    content: "+";
  }
  .internships[open] .internship-toggle::before {
    content: "−";
  }
  .internship-list {
    padding-top: 1rem;
  }
</style>
