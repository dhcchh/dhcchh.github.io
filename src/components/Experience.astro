---
import { siteConfig } from "../config";
import Section from "./ui/Section.astro";
import ExperienceItem from "./ExperienceItem.astro";
interface Props {
  heading?: "h1" | "h2";
}
const { heading = "h2" } = Astro.props;
---

{siteConfig.experience.length > 0 && (
  <Section
    id="experience"
    eyebrow="Putting it into practice"
    title="Where I've been."
    heading={heading}
  >
    {siteConfig.experience.map((experience, index) => (
      <ExperienceItem
        experience={experience}
        expanded={index === 0}
        heading={heading === "h1" ? "h2" : "h3"}
      />
    ))}
  </Section>
)}
