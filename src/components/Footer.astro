---
import { siteConfig } from "../config";
import SocialLinks from "./ui/SocialLinks.astro";
---

<footer class="container site-footer">
  <div class="contact">
    <div>
      <p class="eyebrow">Keep in touch</p>
      <h2 class="display">Let's make it useful.</h2>
    </div>
    {siteConfig.social.email && (
      <a class="text-link" href={`mailto:${siteConfig.social.email}`}>
        {siteConfig.social.email}
        <span aria-hidden="true">↗</span>
      </a>
    )}
  </div>
  <div class="footer-bottom">
    <p>
      © {new Date().getFullYear()} {siteConfig.name}
    </p>
    <SocialLinks />
    <a class="back-top" href="#top">
      Back to top ↑
    </a>
  </div>
</footer>
<style>
  .site-footer {
    padding-block: 4rem 2rem;
    border-top: 1px solid rgb(var(--color-border));
  }
  .contact {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 2rem;
    padding-bottom: 4rem;
  }
  h2 {
    font-size: clamp(2.5rem, 5vw, 4rem);
    margin-top: 0.8rem;
  }
  .contact a {
    overflow-wrap: anywhere;
  }
  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1.5rem;
    border-top: 1px solid rgb(var(--color-border));
    padding-top: 1.5rem;
    font: 0.7rem/1.7 var(--font-mono);
    color: rgb(var(--color-text-muted));
  }
  .back-top:hover {
    color: var(--link-color);
  }
  @media (max-width: 700px) {
    .contact {
      align-items: flex-start;
      flex-direction: column;
      padding-bottom: 3rem;
    }
  }
</style>
