---
import { siteConfig } from "../config";
import Section from "./ui/Section.astro";
---

{siteConfig.education.length > 0 && (
  <Section id="education" eyebrow="The foundations" title="Always a student.">
    <div class="education-list">
      {siteConfig.education.map((education) => (
        <article>
          <p class="eyebrow">{education.dateRange}</p>
          <h3>{education.school}</h3>
          <p class="degree">{education.degree}</p>
          <p class="paragraphs">{education.description}</p>
          {education.relevantCoursework.length > 0 && (
            <details>
              <summary>Relevant coursework</summary>
              <ul role="list">
                {education.relevantCoursework.map((course) => (
                  <li>{course}</li>
                ))}
              </ul>
            </details>
          )}
        </article>
      ))}
    </div>
  </Section>
)}
<style>
  .education-list {
    display: grid;
    gap: 2rem;
  }
  h3 {
    font-size: 1.3rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    margin-top: 0.6rem;
  }
  .degree {
    margin-top: 0.4rem;
    color: var(--link-color);
    font-size: 0.9rem;
  }
  .paragraphs {
    margin-top: 1rem;
    font-size: 0.9rem;
  }
  details {
    margin-top: 1.25rem;
    font-size: 0.85rem;
  }
  summary {
    padding-block: 0.4rem;
  }
  ul {
    display: grid;
    gap: 0.5rem;
    margin-top: 0.75rem;
    color: rgb(var(--color-text-secondary));
  }
</style>
