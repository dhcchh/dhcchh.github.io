---
import { siteConfig } from "../config";
import Section from "./ui/Section.astro";
import ProjectCard from "./ProjectCard.astro";
interface Props {
  heading?: "h1" | "h2";
}
const { heading = "h2" } = Astro.props;
const projects = siteConfig.projects.filter((project) => project.name.trim());
---

{projects.length > 0 && (
  <Section
    id="projects"
    title="Things I've built."
    heading={heading}
    wide
  >
    <div class="project-grid">
      {projects.map((project, index) => (
        <ProjectCard
          project={project}
          index={index}
          heading={heading === "h1" ? "h2" : "h3"}
        />
      ))}
    </div>
  </Section>
)}
<style>
  .project-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.25rem;
  }
</style>
