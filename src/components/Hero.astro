---
import { siteConfig } from "../config";

const heroTitle = `${siteConfig.name} - ${siteConfig.title}`;
---

<section class="hero" aria-labelledby="hero-title">
  <h1 id="hero-title" class="display hero-title" aria-label={heroTitle}>
    <span data-typed-title={heroTitle} aria-hidden="true">{heroTitle}</span><span
      class="cursor"
      aria-hidden="true"
    ></span>
  </h1>
  <div class="description">
    {siteConfig.intro.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
    <p>{siteConfig.intro.learningIntro}</p>
    <ul>
      {siteConfig.intro.learningTopics.map((topic) => <li>{topic}</li>)}
    </ul>
    <p>{siteConfig.intro.closing}</p>
  </div>
</section>
<style>
  .hero {
    max-width: 48rem;
    margin-inline: auto;
    padding-block: clamp(4rem, 9vw, 7rem);
    text-align: left;
  }
  .hero-title {
    margin: 0;
    min-height: 1.1em;
    font-size: clamp(2.25rem, 4vw, 3.75rem);
    white-space: nowrap;
  }
  .cursor {
    display: inline-block;
    width: 0.065em;
    height: 0.82em;
    margin-left: 0.08em;
    background: var(--link-color);
    vertical-align: -0.04em;
    animation: blink 0.9s steps(2, start) infinite;
  }
  .description {
    max-width: 36rem;
    margin-top: 1.8rem;
    font-size: 1.05rem;
    line-height: 1.8;
    color: rgb(var(--color-text-secondary));
  }
  .description p {
    margin: 0;
  }
  .description p + p,
  .description ul {
    margin-top: 1.1rem;
  }
  .description ul {
    padding-left: 1.25rem;
    list-style: disc;
    text-align: left;
  }
  .description li::marker {
    color: var(--link-color);
  }
  @media (min-width: 1100px) {
    .hero {
      max-width: 62rem;
    }
    .description {
      max-width: 56rem;
    }
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  @media (max-width: 700px) {
    .hero-title {
      font-size: clamp(1.35rem, 7vw, 2.5rem);
    }
  }
</style>

<script>
  const title = document.querySelector<HTMLElement>("[data-typed-title]");
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  if (title && !reduceMotion.matches) {
    const fullTitle = title.dataset.typedTitle ?? "";
    let length = 0;
    let isDeleting = false;

    const animateTitle = () => {
      title.textContent = fullTitle.slice(0, length);

      if (!isDeleting && length === fullTitle.length) {
        isDeleting = true;
        window.setTimeout(animateTitle, 1800);
        return;
      }

      if (isDeleting && length === 0) {
        isDeleting = false;
        window.setTimeout(animateTitle, 450);
        return;
      }

      length += isDeleting ? -1 : 1;
      window.setTimeout(animateTitle, isDeleting ? 42 : 76);
    };

    title.textContent = "";
    animateTitle();
  }
</script>
