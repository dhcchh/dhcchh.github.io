---
import { siteConfig } from "../config";
---

<section class="hero" aria-labelledby="hero-title">
  <p class="eyebrow">
    <span class="status-dot" aria-hidden="true"></span>
    {siteConfig.name} / {siteConfig.title}
  </p>
  <h1 id="hero-title" class="display">
    {siteConfig.intro.headline}
    <br />
    <em>{siteConfig.intro.emphasis}</em>
  </h1>
  <p class="description">{siteConfig.intro.description}</p>
  {siteConfig.projects.length > 0 && (
    <a class="button" href="/projects">
      Explore my projects <span aria-hidden="true">↗</span>
    </a>
  )}
</section>
<style>
  .hero {
    max-width: 43rem;
    padding-block: clamp(4rem, 9vw, 7rem);
  }
  .eyebrow {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }
  .status-dot {
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--link-color);
  }
  h1 {
    font-size: clamp(3.3rem, 6.3vw, 5.6rem);
    margin-top: 1.8rem;
  }
  h1 em {
    color: var(--link-color);
    font-weight: 400;
  }
  .description {
    max-width: 36rem;
    margin-top: 1.6rem;
    font-size: 1.05rem;
    line-height: 1.8;
    color: rgb(var(--color-text-secondary));
  }
  .button {
    margin-top: 2rem;
  }
  @media (max-width: 900px) {
    h1 {
      font-size: 3.8rem;
    }
  }
  @media (max-width: 700px) {
    h1 {
      font-size: clamp(3rem, 11.5vw, 4.5rem);
    }
  }
</style>
