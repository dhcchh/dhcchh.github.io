---
import { siteConfig } from "../config";
---

<section class="hero" aria-labelledby="hero-title">
  <p class="eyebrow">
    <span class="status-dot" aria-hidden="true"></span>
    {siteConfig.name} - {siteConfig.title}
  </p>
  <h1 id="hero-title" class="sr-only">{siteConfig.name}, {siteConfig.title}</h1>
  <div class="description">
    {siteConfig.intro.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
    <p>{siteConfig.intro.learningIntro}</p>
    <ul>
      {siteConfig.intro.learningTopics.map((topic) => <li>{topic}</li>)}
    </ul>
    <p>{siteConfig.intro.closing}</p>
  </div>
  {siteConfig.projects.length > 0 && (
    <a class="button" href="/projects">
      Explore my projects <span aria-hidden="true">↗</span>
    </a>
  )}
</section>
<style>
  .hero {
    max-width: 43rem;
    padding-block: clamp(4rem, 9vw, 7rem);
  }
  .eyebrow {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }
  .status-dot {
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--link-color);
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  .description {
    max-width: 36rem;
    margin-top: 1.8rem;
    font-size: 1.05rem;
    line-height: 1.8;
    color: rgb(var(--color-text-secondary));
  }
  .description p {
    margin: 0;
  }
  .description p + p,
  .description ul {
    margin-top: 1.1rem;
  }
  .description ul {
    padding-left: 1.25rem;
  }
  .button {
    margin-top: 2rem;
  }
</style>
