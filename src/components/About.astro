---
import { siteConfig } from "../config";
import Section from "./ui/Section.astro";
import TagList from "./ui/TagList.astro";
interface Props {
  heading?: "h1" | "h2";
}
const { heading = "h2" } = Astro.props;
const current = siteConfig.experience.find((role) =>
  /present/i.test(role.dateRange),
);
const currentSkills = current?.skills.slice(0, 4) ?? [];
---

{siteConfig.aboutMe && (
  <Section
    id="about"
    eyebrow="The person behind the work"
    title="A little context."
    heading={heading}
  >
    <div class="paragraphs about-copy">
      {current && (
        <p class="current-focus">
          I’m currently a {current.title} at {current.company}, working with {currentSkills.join(
            ", ",
          )}.
        </p>
      )}
      {siteConfig.aboutMe.split(/\n\s*\n/).map((paragraph) => (
        <p>{paragraph.trim()}</p>
      ))}
    </div>
    {siteConfig.skills.length > 0 && (
      <div class="skills">
        <TagList items={siteConfig.skills} />
      </div>
    )}
  </Section>
)}
<style>
  .about-copy {
    font-size: 1.15rem;
  }
  .current-focus {
    color: rgb(var(--color-text-primary));
  }
  .skills {
    margin-top: 1.5rem;
  }
</style>
