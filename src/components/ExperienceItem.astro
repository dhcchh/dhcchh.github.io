---
import type { siteConfig } from "../config";
import TagList from "./ui/TagList.astro";
interface Props {
  experience: (typeof siteConfig.experience)[number];
  expanded?: boolean;
  heading?: "h2" | "h3";
}
const { experience, expanded = false, heading: Heading = "h3" } = Astro.props;
---

<details class="experience-item" open={expanded}>
  <summary>
    <div>
      <Heading class="company-title">{experience.company}</Heading>
      <p class="role">{experience.title}</p>
    </div>
    <div class="end">
      <span class="dates">{experience.dateRange}</span>
      <span class="expand" aria-hidden="true"></span>
    </div>
  </summary>
  <div class="detail">
    <ul class="bullets">
      {experience.bullets.map((bullet) => (
        <li>{bullet}</li>
      ))}
    </ul>
    {experience.skills && (
      <div class="skills">
        <TagList items={experience.skills} />
      </div>
    )}
  </div>
</details>
<style>
  .experience-item {
    border-bottom: 1px solid rgb(var(--color-border));
  }
  .experience-item:first-of-type summary {
    padding-top: 0;
  }
  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    list-style: none;
    padding-block: 1.65rem;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .company-title {
    font-size: 1.35rem;
    font-weight: 600;
    letter-spacing: -0.025em;
  }
  .role {
    color: rgb(var(--color-text-secondary));
    margin-top: 0.25rem;
    font-size: 0.85rem;
  }
  .end {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }
  .dates {
    font: 0.65rem/1.6 var(--font-mono);
    color: rgb(var(--color-text-muted));
    white-space: nowrap;
  }
  .expand {
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border: 1px solid rgb(var(--color-border));
    border-radius: 50%;
  }
  .expand::before {
    content: "+";
  }
  [open] .expand::before {
    content: "−";
  }
  summary:hover .company-title {
    color: var(--link-color);
  }
  .detail {
    padding-bottom: 1.75rem;
    font-size: 0.9rem;
  }
  .bullets {
    padding-left: 1.25rem;
    color: rgb(var(--color-text-secondary));
    line-height: 1.8;
    list-style: disc;
  }
  .bullets li + li {
    margin-top: 0.7rem;
  }
  .bullets li::marker {
    color: var(--link-color);
  }
  .skills {
    margin-top: 1.25rem;
  }
  @media (max-width: 550px) {
    .end {
      align-items: flex-end;
      flex-direction: column-reverse;
      gap: 0.5rem;
    }
    .dates {
      font-size: 0.55rem;
    }
  }
</style>
