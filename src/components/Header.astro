---
import { siteConfig } from "../config";
import { getPosts } from "../lib/posts";
import ThemeToggle from "./ThemeToggle.astro";
const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";
const currentPage = (href: string) => {
  if (pathname === href) return "page";
  if (href !== "/" && pathname.startsWith(`${href}/`)) return "location";
  return undefined;
};
const links = [
  { label: "Home", href: "/" },
  ...(siteConfig.experience.length
    ? [{ label: "Experience", href: "/experience" }]
    : []),
  ...(siteConfig.projects.some((project) => project.name.trim())
    ? [{ label: "Projects", href: "/projects" }]
    : []),
  ...((await getPosts({ includeDrafts: false })).length
    ? [{ label: siteConfig.blog.navLabel, href: "/blog" }]
    : []),
];
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label={`${siteConfig.name} — home`}>
      <span class="monogram" aria-hidden="true">
        {siteConfig.name
          .split(" ")
          .map((part) => part[0])
          .join("")}
        <span>.</span>
      </span>
      <span class="brand-name">{siteConfig.name}</span>
    </a>
    <nav aria-label="Main navigation">
      {links.map(({ label, href }) => (
        <a href={href} aria-current={currentPage(href)}>
          {label}
        </a>
      ))}
    </nav>
    <ThemeToggle />
  </div>
</header>
<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid rgb(var(--color-border));
    background: rgb(var(--color-background) / 0.95);
    backdrop-filter: blur(12px);
  }
  .header-inner {
    display: flex;
    align-items: center;
    gap: 2rem;
    min-height: 84px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-right: auto;
  }
  .monogram {
    font-size: 1.5rem;
    font-weight: 750;
    letter-spacing: -0.08em;
  }
  .monogram span {
    color: var(--link-color);
  }
  .brand-name {
    font-size: 0.8rem;
    font-weight: 600;
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.8rem;
  }
  nav a {
    font-size: 0.8rem;
    padding-block: 0.65rem;
    border-bottom: 2px solid transparent;
    color: rgb(var(--color-text-secondary));
  }
  nav a:hover,
  nav a[aria-current] {
    color: var(--link-color);
  }
  nav a[aria-current] {
    border-bottom-color: var(--link-color);
  }
  @media (max-width: 700px) {
    .header-inner {
      flex-wrap: wrap;
      gap: 0 1rem;
      padding-top: 0.6rem;
    }
    .brand-name {
      font-size: 0.75rem;
    }
    nav {
      order: 3;
      width: 100%;
      justify-content: space-between;
      gap: 0.75rem;
      padding-block: 0.25rem;
    }
    nav a {
      font-size: 0.75rem;
    }
  }
</style>
