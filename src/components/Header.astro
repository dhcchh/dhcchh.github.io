---
import { siteConfig } from "../config";
import { getPosts } from "../lib/posts";
import ThemeToggle from "./ThemeToggle.astro";
const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";
const currentPage = (href: string) => {
  if (pathname === href) return "page";
  if (href !== "/" && pathname.startsWith(`${href}/`)) return "location";
  return undefined;
};
const links = [
  { label: "Home", href: "/" },
  ...(siteConfig.experience.length
    ? [{ label: "Experience", href: "/experience" }]
    : []),
  ...(siteConfig.projects.some((project) => project.name.trim())
    ? [{ label: "Projects", href: "/projects" }]
    : []),
  ...((await getPosts({ includeDrafts: false })).length
    ? [{ label: siteConfig.blog.navLabel, href: "/blog" }]
    : []),
];
---

<header class="site-header">
  <div class="container header-inner">
    <nav aria-label="Main navigation">
      {links.map(({ label, href }) => (
        <a href={href} aria-current={currentPage(href)}>
          {label}
        </a>
      ))}
    </nav>
    <ThemeToggle />
  </div>
</header>
<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid rgb(var(--color-border));
    background: rgb(var(--color-background) / 0.95);
    backdrop-filter: blur(12px);
  }
  .header-inner {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 2rem;
    min-height: 84px;
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.8rem;
  }
  nav a {
    font-size: 0.8rem;
    padding-block: 0.65rem;
    border-bottom: 2px solid transparent;
    color: rgb(var(--color-text-secondary));
  }
  nav a:hover,
  nav a[aria-current] {
    color: var(--link-color);
  }
  nav a[aria-current] {
    border-bottom-color: var(--link-color);
  }
  .header-inner > :global(#theme-toggle) {
    position: absolute;
    top: 1.25rem;
    right: 0;
  }

  @media (max-width: 700px) {
    .header-inner {
      flex-wrap: wrap;
      justify-content: flex-end;
      gap: 0;
      padding-top: 0.6rem;
    }
    /* No room beside the centered links; give the toggle its own row. */
    .header-inner > :global(#theme-toggle) {
      position: static;
    }
    nav {
      order: 3;
      width: 100%;
      justify-content: center;
      gap: 1.25rem;
      padding-block: 0.25rem;
    }
    nav a {
      font-size: 0.75rem;
    }
  }
</style>
