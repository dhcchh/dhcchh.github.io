---
import { siteConfig } from "../../config";
const links = [
  {
    key: "email",
    label: siteConfig.social.email,
    href: `mailto:${siteConfig.social.email}`,
  },
  { key: "linkedin", label: "LinkedIn", href: siteConfig.social.linkedin },
  { key: "github", label: "GitHub", href: siteConfig.social.github },
].filter((link) => link.href);
---

<ul class="social-links" role="list" aria-label="Contact links">
  {links.map(({ key, label, href }) => (
    <li>
      <a href={href} aria-label={label}>
        {key === "email" && (
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <rect x="3" y="5" width="18" height="14" rx="2"></rect>
            <path d="m3 7 9 6 9-6"></path>
          </svg>
        )}
        {key === "linkedin" && (
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M6.5 8.5v9M6.5 5.5v.01M10.5 17.5v-5.25a3.25 3.25 0 0 1 6.5 0v5.25"></path>
          </svg>
        )}
        {key === "github" && (
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M15 22v-3.87c.04-.5-.13-.99-.46-1.37 3.76-.42 7.71-1.85 7.71-8.34a6.52 6.52 0 0 0-1.73-4.53A6.05 6.05 0 0 0 20.36.7S19 .28 16 2.29a13.4 13.4 0 0 0-8 0C5 .28 3.64.7 3.64.7a6.05 6.05 0 0 0-.16 3.16 6.52 6.52 0 0 0-1.73 4.53c0 6.48 3.94 7.92 7.7 8.34-.33.38-.5.87-.46 1.37V22"></path>
            <path d="M9 18c-3 .92-3-1.5-4.2-1.8"></path>
          </svg>
        )}
        {key === "email" ? <span>{label}</span> : null}
      </a>
    </li>
  ))}
</ul>
<style>
  .social-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }
  a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    min-height: 2rem;
    color: rgb(var(--color-text-secondary));
    font: 0.75rem/1.7 var(--font-mono);
  }
  li:not(:first-child) a {
    width: 2rem;
    border: 1px solid rgb(var(--color-border));
    border-radius: 50%;
  }
  svg {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.8;
  }
  a:hover {
    color: var(--link-color);
    text-decoration: underline;
  }
  li:not(:first-child) a:hover {
    text-decoration: none;
    border-color: var(--link-color);
  }
</style>
