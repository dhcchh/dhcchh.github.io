---
interface Props {
  items: string[];
  label?: string;
}
const { items, label = "Technologies" } = Astro.props;
---

{items.length > 0 && (
  <ul class="tags" aria-label={label} role="list">
    {items.map((item) => (
      <li>{item}</li>
    ))}
  </ul>
)}
<style>
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }
  li {
    border: 1px solid rgb(var(--color-border));
    padding: 0.3rem 0.6rem;
    border-radius: 3px;
    color: rgb(var(--color-text-secondary));
    font: 0.65rem/1.5 var(--font-mono);
  }
</style>
