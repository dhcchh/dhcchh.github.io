---
import type { Post } from "../../lib/posts";
interface Props {
  newer?: Post;
  older?: Post;
}
const { newer, older } = Astro.props;
const links = [
  { post: older, label: "Older article", arrow: "←" },
  { post: newer, label: "Newer article", arrow: "→" },
].filter((link) => link.post);
---

<nav class="post-navigation" aria-label="More writing">
  {links.length ? (
    links.map(({ post, label, arrow }) => (
      <a href={`/blog/${post!.id}`}>
        <span class="eyebrow">
          {arrow} {label}
        </span>
        <span class="title">{post!.data.title}</span>
      </a>
    ))
  ) : (
    <a class="text-link" href="/blog">
      ← Back to all writing
    </a>
  )}
</nav>
<style>
  .post-navigation {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 2rem;
    padding-top: 2rem;
    margin-top: 3rem;
    border-top: 1px solid rgb(var(--color-border));
  }
  a {
    flex: 1 1 200px;
  }
  a:hover {
    color: var(--link-color);
  }
  .title {
    display: block;
    font-size: 1rem;
    line-height: 1.5;
    margin-top: 0.5rem;
  }
</style>
