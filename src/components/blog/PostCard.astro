---
import { readingTime, type Post } from "../../lib/posts";
import TagList from "../ui/TagList.astro";
import PostMeta from "./PostMeta.astro";
interface Props {
  post: Post;
  children?: Post[];
  heading?: "h2" | "h3";
}
const { post, children = [], heading: Heading = "h3" } = Astro.props;
const href = post.data.externalUrl ?? `/blog/${post.id}`;
const isExternal = Boolean(post.data.externalUrl);
const minutes =
  post.data.readingMinutes ??
  (post.data.externalUrl ? undefined : readingTime(post.body));
---

<article class="post-card">
  <PostMeta post={post} minutes={minutes} />
  <Heading class="post-title">
    {
      isExternal ? (
        <a href={href} target="_blank" rel="noreferrer">
          {post.data.title}
          <span aria-hidden="true">↗</span>
          <span class="sr-only"> (opens in a new tab)</span>
        </a>
      ) : (
        <a href={href}>
          {post.data.title}
          <span aria-hidden="true">↗</span>
        </a>
      )
    }
  </Heading>
  <p>{post.data.description}</p>
  {children.length > 0 && (
    <details class="subposts" aria-label={`Articles in ${post.data.title}`}>
      <summary class="series-label">In this series ({children.length})</summary>
      <ol>
        {children.map((child) => {
          const childHref = child.data.externalUrl ?? `/blog/${child.id}`;
          const childIsExternal = Boolean(child.data.externalUrl);
          return (
            <li>
              {childIsExternal ? (
                <a href={childHref} target="_blank" rel="noreferrer">
                  {child.data.title}
                  <span aria-hidden="true">↗</span>
                  <span class="sr-only"> (opens in a new tab)</span>
                </a>
              ) : (
                <a href={childHref}>{child.data.title}</a>
              )}
              <p>{child.data.description}</p>
            </li>
          );
        })}
      </ol>
    </details>
  )}
  <TagList items={post.data.tags} label="Topics" />
</article>
<style>
  .post-card {
    padding-block: 2rem;
    border-top: 1px solid rgb(var(--color-border));
  }
  .post-card:first-child {
    border-top: 0;
    padding-top: 0;
  }
  .post-title {
    font-size: clamp(1.4rem, 2.5vw, 1.8rem);
    font-weight: 550;
    line-height: 1.35;
    letter-spacing: -0.035em;
    margin-top: 0.9rem;
  }
  .post-title a {
    display: flex;
    gap: 2rem;
    justify-content: space-between;
  }
  .post-title a:hover {
    color: var(--link-color);
  }
  .post-title span {
    font-weight: 400;
    color: var(--link-color);
  }
  p {
    line-height: 1.8;
    color: rgb(var(--color-text-secondary));
    font-size: 0.95rem;
    margin-block: 0.8rem 1.1rem;
  }
  .subposts {
    width: 100%;
    margin: 1.6rem 0 0.4rem;
    padding: 1rem 1.25rem;
    border-left: 2px solid var(--link-color);
    background: rgb(var(--color-surface) / 0.35);
  }
  .series-label {
    list-style: none;
    font: 0.65rem/1.4 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgb(var(--color-text-muted));
  }
  .series-label::-webkit-details-marker {
    display: none;
  }
  .series-label::before {
    content: "▸";
    display: inline-block;
    margin-right: 0.6em;
    transition: transform 0.15s ease;
  }
  .subposts[open] .series-label::before {
    transform: rotate(90deg);
  }
  .series-label:hover {
    color: var(--link-color);
  }
  ol {
    display: grid;
    gap: 1rem;
    margin: 0.85rem 0 0;
    padding-left: 1.35rem;
  }
  li {
    padding-left: 0.25rem;
  }
  li a {
    font-size: 0.9rem;
    font-weight: 600;
    line-height: 1.5;
  }
  li a:hover {
    color: var(--link-color);
  }
  li a span {
    margin-left: 0.35rem;
    font-weight: 400;
    color: var(--link-color);
  }
  li p {
    margin: 0.25rem 0 0;
    font-size: 0.82rem;
  }
</style>
