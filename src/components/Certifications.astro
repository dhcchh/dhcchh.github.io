---
import { siteConfig } from "../config";
import Section from "./ui/Section.astro";
---

{siteConfig.certifications.length > 0 && (
  <Section
    id="certifications"
    eyebrow="Continuing to learn"
    title="Credentials."
  >
    <ul class="credentials" role="list">
      {siteConfig.certifications.map((cert) => (
        <li>
          <a href={cert.credentialUrl}>
            {cert.image && (
              <img
                src={cert.image}
                alt=""
                width="64"
                height="64"
                loading="lazy"
              />
            )}
            <div>
              <h3>
                {cert.name} <span aria-hidden="true">↗</span>
              </h3>
              <p>
                {cert.issuer}
                {cert.dateObtained && ` · ${cert.dateObtained}`}
              </p>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </Section>
)}
<style>
  .credentials {
    display: grid;
    gap: 1.5rem;
  }
  a {
    display: flex;
    gap: 1rem;
    align-items: center;
  }
  img {
    object-fit: contain;
  }
  h3 {
    font-weight: 600;
  }
  a:hover h3 {
    color: var(--link-color);
  }
  p {
    margin-top: 0.4rem;
    font-size: 0.8rem;
    color: rgb(var(--color-text-secondary));
  }
</style>
