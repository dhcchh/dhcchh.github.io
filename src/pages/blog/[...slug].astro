---
import { render } from "astro:content";
import BlogPostLayout from "../../layouts/BlogPostLayout.astro";
import { getPosts, readingTime } from "../../lib/posts";

export async function getStaticPaths() {
  const posts = await getPosts();
  const internalPosts = posts.filter((post) => !post.data.externalUrl);
  return internalPosts.map((post, i) => ({
    params: { slug: post.id },
    props: {
      post,
      newer: internalPosts[i - 1],
      older: internalPosts[i + 1],
    },
  }));
}

const { post, newer, older } = Astro.props;
const { Content, headings } = await render(post);
const minutes = readingTime(post.body);
---

<BlogPostLayout
  post={post}
  minutes={minutes}
  headings={headings}
  newer={newer}
  older={older}
>
  <Content />
</BlogPostLayout>
