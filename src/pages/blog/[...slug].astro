---
import { render } from "astro:content";
import BlogPostLayout from "../../layouts/BlogPostLayout.astro";
import { getPosts, readingTime } from "../../lib/posts";

export async function getStaticPaths() {
  const posts = await getPosts();
  const internalPosts = posts.filter((post) => !post.data.externalUrl);
  return internalPosts.map((post, i) => ({
    params: { slug: post.id },
    props: {
      post,
      newer: internalPosts[i - 1],
      older: internalPosts[i + 1],
    },
  }));
}

const { post, newer, older } = Astro.props;
const { Content, headings: renderedHeadings, remarkPluginFrontmatter } =
  await render(post);
// Math headings get clean labels from rehype-heading-math.mjs.
const labels: Record<string, string> = remarkPluginFrontmatter.headingLabels ?? {};
const headings = renderedHeadings.map((heading) => ({
  ...heading,
  text: labels[heading.slug] ?? heading.text,
}));
const minutes = post.data.readingMinutes ?? readingTime(post.body);
---

<BlogPostLayout
  post={post}
  minutes={minutes}
  headings={headings}
  newer={newer}
  older={older}
>
  <Content />
</BlogPostLayout>
