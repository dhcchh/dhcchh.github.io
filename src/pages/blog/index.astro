---
import SiteLayout from "../../layouts/SiteLayout.astro";
import PostCard from "../../components/blog/PostCard.astro";
import { siteConfig } from "../../config";
import { getPosts } from "../../lib/posts";
const posts = await getPosts();
const { title, description } = siteConfig.blog;
---

<SiteLayout title={`${title} — ${siteConfig.name}`} description={description}>
  <div class="container writing-page">
    <header>
      <p class="eyebrow">Ideas, experiments & lessons learned</p>
      <h1 class="display">
        {title}
        <span>.</span>
      </h1>
      <p class="description">{description}</p>
      <a class="text-link" href="/rss.xml">
        Subscribe via RSS <span aria-hidden="true">↗</span>
      </a>
    </header>
    <section class="posts" aria-label="Articles">
      {posts.length ? (
        posts.map((post) => <PostCard post={post} heading="h2" />)
      ) : (
        <p class="empty-state">
          No posts yet. A few things are taking shape—check back soon.
        </p>
      )}
    </section>
  </div>
</SiteLayout>
<style>
  .writing-page {
    display: grid;
    grid-template-columns: 1fr 1.7fr;
    gap: 5rem;
    padding-block: 5rem 7rem;
  }
  h1 {
    font-size: clamp(3.5rem, 6vw, 5rem);
    margin-top: 1.25rem;
  }
  h1 span {
    color: var(--link-color);
  }
  .description {
    font-size: 1rem;
    line-height: 1.8;
    color: rgb(var(--color-text-secondary));
    margin-block: 1.5rem;
  }
  .text-link {
    font-size: 0.8rem;
  }
  .posts {
    min-width: 0;
  }
  .empty-state {
    color: rgb(var(--color-text-secondary));
    line-height: 1.8;
  }
  @media (max-width: 850px) {
    .writing-page {
      grid-template-columns: 1fr;
      gap: 3rem;
      padding-block: 3rem 5rem;
    }
  }
</style>
