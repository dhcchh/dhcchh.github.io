---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { siteConfig } from "../../config";
import { getPublishedPosts, formatDate } from "../../lib/posts";

const posts = await getPublishedPosts();
const { title, description } = siteConfig.blog;
const accent = `--accent-color:${siteConfig.accentColor}`;
---

<BaseLayout title={`${title} — ${siteConfig.name}`} description={description}>
  <Header />
  <main class="mx-auto max-w-3xl px-6 pt-28 pb-20 sm:px-8">
    <a
      href="/"
      class="text-sm text-text-muted hover:text-text-primary transition-colors"
    >
      ← Home
    </a>

    <h1 class="mt-6 text-4xl sm:text-5xl font-bold text-text-primary">{title}</h1>
    <div
      class="w-[75px] h-[5px] mt-2 rounded-full"
      style={`background-color: ${siteConfig.accentColor}`}
    >
    </div>
    <p class="mt-6 text-lg text-text-secondary">{description}</p>

    {
      posts.length === 0 ? (
        <p class="mt-16 text-text-muted">No posts yet — check back soon.</p>
      ) : (
        <ul class="mt-12 space-y-10">
          {posts.map((post) => (
            <li>
              <a href={`/blog/${post.id}`} class="group block" style={accent}>
                <div class="flex items-baseline justify-between gap-4">
                  <h2 class="text-xl sm:text-2xl font-semibold text-text-primary transition-colors group-hover:text-[var(--accent-color)]">
                    {post.data.title}
                  </h2>
                  <time
                    datetime={post.data.pubDate.toISOString()}
                    class="shrink-0 text-sm text-text-muted"
                  >
                    {formatDate(post.data.pubDate)}
                  </time>
                </div>
                <p class="mt-2 text-text-secondary">{post.data.description}</p>
                {post.data.tags.length > 0 && (
                  <ul class="mt-3 flex flex-wrap gap-2">
                    {post.data.tags.map((t) => (
                      <li class="px-2.5 py-1 rounded-full text-xs bg-surface text-text-secondary border border-border">
                        {t}
                      </li>
                    ))}
                  </ul>
                )}
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </main>
  <Footer />
</BaseLayout>
