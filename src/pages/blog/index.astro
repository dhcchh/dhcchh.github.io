---
import SiteLayout from "../../layouts/SiteLayout.astro";
import PostCard from "../../components/blog/PostCard.astro";
import Section from "../../components/ui/Section.astro";
import { siteConfig } from "../../config";
import { getPosts } from "../../lib/posts";
const posts = await getPosts();
const { title, description } = siteConfig.blog;
const topLevelPosts = posts.filter((post) => !post.data.parentSlug);
const childrenFor = (parentSlug: string) =>
  posts
    .filter((post) => post.data.parentSlug === parentSlug)
    .sort((a, b) => a.id.localeCompare(b.id));
---

<SiteLayout
  title={`${title} — ${siteConfig.name}`}
  description={description}
  showFooter={false}
>
  <div class="container">
    <Section id="blog" title={`${title}.`} heading="h1" wide>
      <p slot="intro" class="description">{description}</p>
      <section class="posts" aria-label="Articles">
        {topLevelPosts.length ? (
          topLevelPosts.map((post) => (
            <PostCard post={post} children={childrenFor(post.id)} heading="h2" />
          ))
        ) : (
          <p class="empty-state">
            No posts yet. A few things are taking shape—check back soon.
          </p>
        )}
      </section>
    </Section>
  </div>
</SiteLayout>
<style>
  .description {
    font-size: 1rem;
    line-height: 1.8;
    color: rgb(var(--color-text-secondary));
    margin: 1rem 0 0;
  }
  .posts {
    min-width: 0;
  }
  .empty-state {
    color: rgb(var(--color-text-secondary));
    line-height: 1.8;
  }
</style>
